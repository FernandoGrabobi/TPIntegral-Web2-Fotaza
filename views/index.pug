extends layout

block content
  h1= message
  hr
  
  if posts && posts.length > 0
    .gallery
      each post in posts
        .post-card
          img(src=post.media_url, alt=post.title, class="img-thumb")
          .post-info
            h3= post.title
            p= post.description
            span.license= post.license_type === 'copyright' ? '© Copyright' : 'CC'
  else
    p No hay publicaciones todavía. ¡Sé el primero en subir una!