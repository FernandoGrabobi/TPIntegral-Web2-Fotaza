extends ../layout

block content
  .min-h-screen.flex.items-center.justify-center.py-12.px-4
    .w-full.max-w-md
      .bg-white.rounded-2xl.shadow-xl.p-8
        .text-center.mb-8
          p.text-5xl.mb-3 📸
          h1.text-3xl.font-extrabold.text-gray-900 Iniciar sesión
          p.text-gray-500.mt-1 Bienvenido/a de nuevo a Fotaza 2

        form(action="/auth/login" method="POST")
          .mb-4
            label.block.text-sm.font-medium.text-gray-700.mb-1(for="email") Email
            input#email.w-full.border.border-gray-300.rounded-xl.px-4.py-3.focus_outline-none.focus_border-orange-500.focus_ring-2.focus_ring-orange-100(
              type="email" name="email" required placeholder="tu@email.com"
            )
          .mb-6
            label.block.text-sm.font-medium.text-gray-700.mb-1(for="password") Contraseña
            input#password.w-full.border.border-gray-300.rounded-xl.px-4.py-3.focus_outline-none.focus_border-orange-500.focus_ring-2.focus_ring-orange-100(
              type="password" name="password" required placeholder="••••••••"
            )
          button.w-full.bg-orange-500.hover_bg-orange-600.text-white.font-bold.py-3.rounded-xl.transition-colors(type="submit")
            | Ingresar

        .text-center.mt-6.text-sm.text-gray-500
          | ¿No tenés cuenta?&nbsp;
          a.text-orange-500.font-semibold.hover_underline(href="/auth/register") Registrate gratis
