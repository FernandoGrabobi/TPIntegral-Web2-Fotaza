extends ../layout

block content
  .max-w-md.mx-auto.px-4.py-10
    .bg-white.rounded-2xl.shadow-lg.p-6
      h1.text-xl.font-bold.text-gray-800.mb-2 🔖 Guardar en colección
      p.text-sm.text-gray-400.mb-5 Elegí una colección donde guardar esta publicación.

      if collections && collections.length > 0
        .space-y-3.mb-4
          each col in collections
            form(action=`/collections/${col.id}/add/${postId}` method="POST")
              button.w-full.flex.items-center.justify-between.border.border-gray-200.rounded-xl.px-4.py-3.hover_border-orange-400.hover_bg-orange-50.transition-colors(type="submit")
                span.font-medium.text-gray-700= col.name
                span.text-sm.text-gray-400 #{col.posts ? col.posts.length : 0} items
      else
        p.text-gray-400.text-sm.mb-4 No tenés colecciones. Creá una primero.

      .border-t.border-gray-100.pt-4.mt-2
        a.text-orange-500.text-sm.hover_underline(href="/collections") + Crear nueva colección
        |  ·  
        a.text-gray-400.text-sm.hover_underline(href="javascript:history.back()") Cancelar
