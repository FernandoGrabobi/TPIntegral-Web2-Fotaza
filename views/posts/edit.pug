extends ../layout

block content
  .max-w-2xl.mx-auto.px-4.py-10
    .bg-white.rounded-2xl.shadow-lg.p-8
      h1.text-2xl.font-bold.text-gray-800.mb-6 ✏️ Editar publicación

      form(action=`/posts/${post.id}/edit` method="POST" enctype="multipart/form-data")

        .mb-5
          label.block.text-sm.font-semibold.text-gray-700.mb-1 Título *
          input.w-full.border.border-gray-300.rounded-xl.px-4.py-3.focus_outline-none.focus_border-orange-500(
            type="text" name="title" required value=post.title maxlength="200"
          )

        .mb-5
          label.block.text-sm.font-semibold.text-gray-700.mb-1 Descripción
          textarea.w-full.border.border-gray-300.rounded-xl.px-4.py-3.focus_outline-none.focus_border-orange-500.resize-none(
            name="description" rows="3"
          )= post.description || ''

        //- Imágenes actuales
        if post.images && post.images.length > 0
          .mb-5
            p.text-sm.font-semibold.text-gray-700.mb-2 Imágenes actuales
            .flex.flex-wrap.gap-3
              each img in post.images
                .w-24.h-24.rounded-xl.overflow-hidden.border.border-gray-200
                  img.w-full.h-full.object-cover(src=`/uploads/${img.filename}`)

        .mb-5
          label.block.text-sm.font-semibold.text-gray-700.mb-1 Agregar más imágenes (opcional)
          input.w-full.border.border-gray-300.rounded-xl.px-4.py-3(
            type="file" name="images" multiple accept="image/*,video/*"
          )

        .mb-5
          label.block.text-sm.font-semibold.text-gray-700.mb-1 Etiquetas
          - const tagNames = post.tags ? post.tags.map(t => t.name).join(', ') : ''
          input.w-full.border.border-gray-300.rounded-xl.px-4.py-3.focus_outline-none.focus_border-orange-500(
            type="text" name="tags" value=tagNames placeholder="paisaje, naturaleza, ciudad"
          )

        .mb-6
          label.block.text-sm.font-semibold.text-gray-700.mb-2 Licencia
          .grid.grid-cols-2.gap-3
            label.flex.items-center.gap-3.border.border-gray-200.rounded-xl.p-4.cursor-pointer(for="lic_free")
              input#lic_free(type="radio" name="license_type" value="free" checked=(post.license_type==='free'))
              span Sin copyright
            label.flex.items-center.gap-3.border.border-gray-200.rounded-xl.p-4.cursor-pointer(for="lic_copy")
              input#lic_copy(type="radio" name="license_type" value="copyright" checked=(post.license_type==='copyright'))
              span Con copyright ©

        .mb-6
          label.block.text-sm.font-semibold.text-gray-700.mb-1 Marca de agua
          input.w-full.border.border-gray-300.rounded-xl.px-4.py-3.focus_outline-none.focus_border-orange-500(
            type="text" name="watermark_text" value=post.watermark_text || '' placeholder="Ej: © Tu Nombre 2026"
          )

        .flex.gap-3
          button.flex-1.bg-orange-500.hover_bg-orange-600.text-white.font-bold.py-3.rounded-xl(type="submit") Guardar cambios
          a.px-6.py-3.border.border-gray-300.text-gray-600.rounded-xl.hover_bg-gray-50(href=`/posts/${post.id}`) Cancelar
