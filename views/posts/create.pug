extends ../layout

block content
  .max-w-2xl.mx-auto.px-4.py-10
    .bg-white.rounded-2xl.shadow-lg.p-8
      h1.text-2xl.font-bold.text-gray-800.mb-6 📤 Nueva publicación

      form(action="/posts/create" method="POST" enctype="multipart/form-data")

        .mb-5
          label.block.text-sm.font-semibold.text-gray-700.mb-1(for="title") Título *
          input#title.w-full.border.border-gray-300.rounded-xl.px-4.py-3.focus_outline-none.focus_border-orange-500(
            type="text" name="title" required placeholder="Un título descriptivo para tu publicación" maxlength="200"
          )

        .mb-5
          label.block.text-sm.font-semibold.text-gray-700.mb-1(for="description") Descripción (opcional)
          textarea#description.w-full.border.border-gray-300.rounded-xl.px-4.py-3.focus_outline-none.focus_border-orange-500.resize-none(
            name="description" rows="3" placeholder="Contá algo sobre esta publicación..."
          )

        .mb-5
          label.block.text-sm.font-semibold.text-gray-700.mb-1 Imágenes / Videos *
          .border-2.border-dashed.border-gray-300.rounded-xl.p-6.text-center.cursor-pointer.hover_border-orange-400.transition-colors(
            onclick="document.getElementById('images').click()"
          )
            p.text-4xl.mb-2 📁
            p.text-gray-500.text-sm Hacé clic para seleccionar archivos
            p.text-gray-400.text-xs.mt-1 JPG, PNG, GIF, WebP, MP4 · Máximo 20MB por archivo · Hasta 10 archivos
          input#images.hidden(type="file" name="images" multiple accept="image/*,video/*" onchange="previewImages(event)")
          .flex.flex-wrap.gap-3.mt-3#preview

        .mb-5
          label.block.text-sm.font-semibold.text-gray-700.mb-1(for="tags") Etiquetas
          input#tags.w-full.border.border-gray-300.rounded-xl.px-4.py-3.focus_outline-none.focus_border-orange-500(
            type="text" name="tags" placeholder="paisaje, naturaleza, ciudad  (separadas por coma)"
          )
          p.text-xs.text-gray-400.mt-1 Separá las etiquetas con comas

        .mb-6
          label.block.text-sm.font-semibold.text-gray-700.mb-2 Tipo de licencia *
          .grid.grid-cols-2.gap-3
            label.flex.items-center.gap-3.border.border-gray-200.rounded-xl.p-4.cursor-pointer.hover_border-orange-400.transition-colors(for="lic_free")
              input#lic_free(type="radio" name="license_type" value="free" checked onchange="toggleWatermark()")
              div
                p.font-medium.text-gray-800 Sin copyright
                p.text-xs.text-gray-400 Contenido libre de uso
            label.flex.items-center.gap-3.border.border-gray-200.rounded-xl.p-4.cursor-pointer.hover_border-orange-400.transition-colors(for="lic_copy")
              input#lic_copy(type="radio" name="license_type" value="copyright" onchange="toggleWatermark()")
              div
                p.font-medium.text-gray-800 Con copyright ©
                p.text-xs.text-gray-400 Podés agregar marca de agua

        #watermark-section.hidden.mb-6
          label.block.text-sm.font-semibold.text-gray-700.mb-1(for="watermark_text") Texto de marca de agua
          input#watermark_text.w-full.border.border-gray-300.rounded-xl.px-4.py-3.focus_outline-none.focus_border-orange-500(
            type="text" name="watermark_text" placeholder="Ej: © Tu Nombre 2026"
          )

        .flex.gap-3
          button.flex-1.bg-orange-500.hover_bg-orange-600.text-white.font-bold.py-3.rounded-xl.transition-colors(type="submit")
            | 📤 Publicar
          a.px-6.py-3.border.border-gray-300.text-gray-600.rounded-xl.hover_bg-gray-50.font-medium(href="/") Cancelar

  script.
    function toggleWatermark() {
      const copy = document.getElementById('lic_copy').checked;
      document.getElementById('watermark-section').classList.toggle('hidden', !copy);
    }
    function previewImages(event) {
      const preview = document.getElementById('preview');
      preview.innerHTML = '';
      Array.from(event.target.files).forEach(file => {
        const reader = new FileReader();
        reader.onload = e => {
          const div = document.createElement('div');
          div.className = 'relative w-20 h-20 rounded-lg overflow-hidden border border-gray-200';
          div.innerHTML = `<img src="${e.target.result}" class="w-full h-full object-cover">`;
          preview.appendChild(div);
        };
        if (file.type.startsWith('image/')) reader.readAsDataURL(file);
      });
    }
