extends layout

block content
  h1 Compartí tu Fotaza 📸
  
  .form-container
    form(action="/posts/create", method="POST", enctype="multipart/form-data")
      div
        label(for="title") Título de la obra:
        input(type="text", name="title", id="title", required)
      
      div
        label(for="description") Descripción (opcional):
        textarea(name="description", id="description", rows="3")
      
      div
        label(for="media") Selecciona tu imagen:
        input(type="file", name="media", id="media", accept="image/*", required)
      
      div
        label(for="license_type") Tipo de Licencia:
        select(name="license_type", id="license_type")
          option(value="no_copyright") Sin Copyright (Libre)
          option(value="copyright") Con Copyright (Marca de agua)
      
      div#watermark-section
        label(for="watermark_text") Texto para la marca de agua:
        input(type="text", name="watermark_text", id="watermark_text", placeholder="Ej: @tunombre")
        small (Solo se aplicará si seleccionas "Con Copyright")

      button(type="submit") Publicar ahora